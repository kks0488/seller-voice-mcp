{
  "name": "seller-voice-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "A voice-first MCP toolkit for hands-busy small sellers",
  "type": "module",
  "license": "MIT",
  "engines": { "node": "22.x" },
  "scripts": {
    "start": "tsx src/local.ts",
    "dev": "tsx watch src/local.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "capture": "tsx scripts/capture.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.2.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.15",
    "playwright": "1.58.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
